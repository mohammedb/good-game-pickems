# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Good Game Ligaen API
GOOD_GAME_LIGAEN_TOKEN=your_bearer_token
GOOD_GAME_SEASON_ID=13162  # Optional: Override default season ID
GOOD_GAME_LOL_DIVISION_ID=12518  # Optional: Override default LoL division ID

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key  # Required for sending emails

# Other configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret